{
  "id": "./crm.html",
  "name": "Dyno Mini CRM",
  "short_name": "Mini CRM",
  "description": "Urus pelanggan, tarikh follow-up dan WhatsApp terus. Semua disimpan dalam telefon anda.",
  "lang": "ms",
  "dir": "ltr",
  "start_url": "./crm.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12021F",
  "theme_color": "#2A0550",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/crm-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/crm-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/crm-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./kongsi.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
